# Vorlage für die Compose-Interpolation (docker-compose.yml liest .env
# automatisch). Diese Datei ist die committed Referenz; das echte .env liegt
# nur lokal (gitignored). Vorlage kopieren:  cp .env.example .env

# --- Docker-Socket-Gruppe (PFLICHT, sonst „Permission denied" am Socket) ---
# Host-GID der Docker-Socket-Gruppe ermitteln:
#   ZimaOS/Linux:        stat -c '%g' /var/run/docker.sock   (typisch 999)
#   Docker Desktop/WSL2: Socket gehört root → 0
DOCKER_GID=999

# --- Dashboard-Port ---
# Host-Port des Dashboards (im Container lauscht es immer auf 8080).
# Nur setzen, wenn 8080 auf dem Host belegt ist.
#DASHBOARD_HTTP_PORT=8080

# --- Datenablage (Instanzen, Mods, Verlauf, Instanz-Backups) ---
# Unkommentiert = Named Volume "mcdata" (Docker-verwaltet, überall lauffähig).
# ZimaOS: Systemplatte ist klein — Daten aufs Storage legen und entkommentieren:
#MCDATA_DIR=/DATA/AppData/mc-dashboard/data
# WICHTIG: MCDATA_DIR muss ein DEDIZIERTES Unterverzeichnis sein — nie /DATA
# selbst oder ein Ordner mit fremden Daten! Der init-Service weigert das
# chown sonst (Abbruch mit FATAL im Log, `docker compose logs init`) und
# blockiert den Dashboard-Start.
# Achtung bei Umzug des Projektordners: Ein Named Volume heißt
# <projektname>_mcdata — ein neuer Ordnername lässt das alte Volume
# verwaist zurück und das Dashboard startet leer. Dann das Volume umbenennen
# (`docker volume rename alt_mcdata neu_mcdata`) oder MCDATA_DIR setzen und
# die Daten dorthin umziehen (z. B. mit `docker run --rm -v alt_mcdata:/from
# -v /neuer/pfad:/to alpine sh -c 'cp -a /from/. /to/'`); Ownership richtet
# der init-Service beim ersten Start automatisch ein.

# --- Backup-Ablage des 6-h-Backup-Daemons (tägliche Volume-Snapshots) ---
# Unkommentiert = ./backups neben der docker-compose.yml.
# ZimaOS: ebenfalls unter /DATA ablegen:
#BACKUPS_DIR=/DATA/AppData/mc-dashboard/backups

# --- Dashboard-Einstellungen (werden als ${VAR:-Default} durchgereicht) ---
# Login & Rollen: ohne DASHBOARD_API_KEY und ohne Benutzer ist die API offen
# (Homelab-Bestandsverhalten). Beim ersten Aufruf den ersten Admin im
# Setup-Dialog anlegen; danach schützt das Login alle /api-Routen (Viewer =
# nur lesen, Admin = voll). DASHBOARD_API_KEY bleibt als Admin-Bypass für
# Skripte/curl voll gültig — erzeugen mit: openssl rand -hex 32
#DASHBOARD_API_KEY=
# Datei-Browser: Upload-Limit je Datei in MiB:
#FILEBROWSER_MAX_UPLOAD_MB=300
# CurseForge-API-Key (kostenlos: console.curseforge.com):
#CF_API_KEY=
# CORS (Default *; bei Reverse-Proxy die echte Origin setzen, z. B.
# https://mc.example.de):
#CORS_ORIGINS=*
# Container-Zeit (Scheduler-/Backup-Zeiten); ohne tzdata-Fix wirkungslos,
# das Image installiert tzdata — z. B.:
#TZ=Europe/Berlin
# --- Crash-Watchdog/Alerts (optional; leer = aus) ---
#ALERT_WEBHOOK_URL=
#TELEGRAM_BOT_TOKEN=
#TELEGRAM_CHAT_ID=
#ALERT_EVENTS=crash,start,stop
# --- Multi-Server-Defaults (selten nötig) ---
#INSTANCES_PORT_BASE=25570
#INSTANCES_MEMORY=2G
#INSTANCES_HOST_DIR=
